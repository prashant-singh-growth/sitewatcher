# MySQL credentials from Hostinger hPanel. URL-encode special characters in the password.
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME"

# FIRST-RUN BOOTSTRAP ONLY. While the users table is empty, signing in with this pair creates the
# Master Admin account (password stored hashed). After that these values are ignored and can be removed.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-unique-long-password"
ADMIN_EMAIL="you@yourdomain.com"

# Cron secret: openssl rand -base64 48. Prefer sending it as the x-cron-secret header.
CRON_SECRET="replace-with-a-long-random-secret"

# SMTP details (unchanged). ALERT_TO is the FALLBACK recipient when a project has no alert emails set.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="monitor@yourdomain.com"
SMTP_PASSWORD="your-mailbox-password"
ALERT_FROM="SiteWatch <monitor@yourdomain.com>"
ALERT_TO="you@yourdomain.com"

# Reserved for the Speed Test module (Phase C). Server-side only; never exposed to the browser.
GOOGLE_PAGESPEED_API_KEY=""

APP_NAME="SiteWatch"
# AUTH_SECRET is no longer used (sessions are opaque DB-backed tokens). It can be deleted.
