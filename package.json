{
  "name": "sitewatch-monitor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:init": "node --env-file=.env scripts/migrate.js up",
    "db:migrate": "node --env-file=.env scripts/migrate.js up",
    "db:rollback": "node --env-file=.env scripts/migrate.js down",
    "db:status": "node --env-file=.env scripts/migrate.js status",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mysql2": "^3.14.1",
    "next": "^15.3.3",
    "nodemailer": "^7.0.3",
    "pdfkit": "^0.20.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "typescript": "^5.8.3"
  }
}
